# .env.example
# ============================================================
# 파일명  : .env.example
# 버전    : V0p1
# 작성일  : 2026-05-13
# 작성자  : johnkft-hub
#
# [주의] 이 파일은 GitHub에 공개됩니다.
#        실제 키 값은 절대 입력하지 마세요.
#        .env 파일을 별도 생성 후 값을 채워주세요.
# ============================================================

# ── Supabase ──
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Groq API ──
GROQ_API_KEY=your-groq-api-key

# ── 네이버 뉴스 API (필수 — developers.naver.com 에서 발급) ──
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# ── 구글 뉴스 RSS (API 키 불필요 — 자동 수집) ──
# Google News RSS는 별도 키 없이 동작합니다

# ── 앱 설정 ──
NEWS_FETCH_LIMIT=50
PRICE_HISTORY_DAYS=7
